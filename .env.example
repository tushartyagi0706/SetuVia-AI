# SetuVia AI Backend Environment Configuration

# Server Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# MongoDB Atlas Credentials (DO NOT commit actual URI to git)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/setuvia?retryWrites=true&w=majority
MONGODB_DB_NAME=setuvia

# LLM Provider Credentials
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Security & CORS
CORS_ORIGINS=["http://localhost:3000"]
